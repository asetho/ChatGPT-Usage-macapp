<Window x:Class="ChatGPTUsage.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="330" Height="460" ResizeMode="NoResize" WindowStyle="None"
        ShowInTaskbar="False" Topmost="True" Background="Transparent"
        AllowsTransparency="True" Deactivated="Window_Deactivated">
    <Border Background="#14171D" BorderBrush="#414650" BorderThickness="1" CornerRadius="14" Padding="18">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Button Visibility="{Binding UpdateAvailableVisibility}" Click="OpenUpdate_Click"
                        Padding="0" Margin="0,0,0,12" HorizontalContentAlignment="Stretch"
                        Background="Transparent" BorderThickness="0" Foreground="#F0F1F4"
                        AutomationProperties.Name="Update available"
                        AutomationProperties.HelpText="Opens the GitHub release page in the default browser">
                    <Border Background="#202A38" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="↓" Foreground="#60A5FA" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="9,0">
                                <TextBlock Text="Update available" FontSize="14" FontWeight="SemiBold" Foreground="#F0F1F4" />
                                <TextBlock Text="{Binding UpdateDescription}" FontSize="12" Foreground="#B4B8C0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="↗" Foreground="#B4B8C0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Button>

                <Separator Background="#414650" />
                <Grid Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Refresh" Click="Refresh_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#E6E8EE" />
                        <TextBlock Text="{Binding RefreshStatus}" Foreground="#858B96" Margin="14,2,0,0" />
                    </StackPanel>
                    <Button Content="Quit" Click="Quit_Click" HorizontalAlignment="Right" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#E6E8EE" />
                </Grid>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="28" Height="28" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="21" Height="21" Stroke="#AEB4BE" StrokeThickness="1.7" />
                                    <Ellipse Canvas.Left="11" Canvas.Top="3.5" Width="2" Height="2" Fill="#AEB4BE" />
                                    <Ellipse Canvas.Left="4.5" Canvas.Top="7" Width="2" Height="2" Fill="#AEB4BE" />
                                    <Ellipse Canvas.Left="4.5" Canvas.Top="15" Width="2" Height="2" Fill="#AEB4BE" />
                                    <Ellipse Canvas.Left="17.5" Canvas.Top="7" Width="2" Height="2" Fill="#AEB4BE" />
                                    <Ellipse Canvas.Left="17.5" Canvas.Top="15" Width="2" Height="2" Fill="#AEB4BE" />
                                    <Line X1="12" Y1="12" X2="14.5" Y2="6.5" Stroke="#AEB4BE" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Ellipse Canvas.Left="10.5" Canvas.Top="10.5" Width="3" Height="3" Fill="#AEB4BE" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Usage remaining" FontSize="21" FontWeight="SemiBold" Foreground="#F0F1F4" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="×" Click="Close_Click" HorizontalAlignment="Right" FontSize="20" Padding="4,-3" Background="Transparent" BorderThickness="0" Foreground="#B4B8C0" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="5h" FontSize="17" Foreground="#F0F1F4" />
                        <TextBlock Grid.Column="1" Text="{Binding FiveHourRemaining}" FontSize="17" Foreground="#B4B8C0" />
                        <TextBlock Grid.Column="2" Text="{Binding FiveHourReset}" FontSize="17" Foreground="#B4B8C0" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Weekly" FontSize="17" Foreground="#F0F1F4" />
                        <TextBlock Grid.Column="1" Text="{Binding WeeklyRemaining}" FontSize="17" Foreground="#B4B8C0" />
                        <TextBlock Grid.Column="2" Text="{Binding WeeklyReset}" FontSize="17" Foreground="#B4B8C0" HorizontalAlignment="Right" />
                    </Grid>

                    <Button Click="OpenUsage_Click" Padding="0,5" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#F0F1F4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ResetTitle}" FontSize="16" />
                            <TextBlock Text="↗" FontSize="16" Foreground="#B4B8C0" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Separator Background="#414650" Margin="0,12,0,8" />
                    <Expander Header="Additional limits" Visibility="{Binding AdditionalLimitsVisibility}" Foreground="#F0F1F4" FontSize="16" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding AdditionalLimits}" Margin="18,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Name}" Foreground="#B4B8C0" FontSize="13" />
                                        <TextBlock Text="{Binding FiveHour}" Foreground="#E6E8EE" FontSize="13" />
                                        <TextBlock Text="{Binding Weekly}" Foreground="#E6E8EE" FontSize="13" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Expander Header="Token usage" Visibility="{Binding TokenUsageVisibility}" Foreground="#F0F1F4" FontSize="16">
                        <ItemsControl ItemsSource="{Binding TokenUsage}" Margin="18,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" Foreground="#B4B8C0" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#E6E8EE" FontSize="13" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB86C" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
